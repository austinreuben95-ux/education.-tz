{
  "entities": {
    "UserProgress": {
      "title": "User Progress",
      "description": "Stores points, streak, level and completed topics for a student.",
      "type": "object",
      "properties": {
        "points": { "type": "number", "description": "Accumulated experience points (EP)." },
        "credits": { "type": "number", "description": "Paid credits for premium features." },
        "streak": { "type": "number", "description": "Consecutive days of study." },
        "level": { "type": "number", "description": "Student's level based on EP." },
        "completedTopics": { "type": "array", "description": "List of IDs for completed topics." },
        "userId": { "type": "string", "description": "The UID of the user." },
        "email": { "type": "string", "description": "User email address." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last time the progress was updated." }
      },
      "required": ["points", "credits", "streak", "level", "completedTopics", "userId"]
    },
    "Admin": {
      "title": "Admin User",
      "description": "Users with administrative privileges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "StudyTip": {
      "title": "Study Room Tip",
      "description": "Quick text tips, formulas, and common NECTA exam traps shared by students.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "authorName": { "type": "string" },
        "authorId": { "type": "string" },
        "type": { "type": "string", "enum": ["tip", "trap", "formula", "question"] },
        "content": { "type": "string" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "subjectId", "authorName", "authorId", "type", "content", "likes", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProgress",
      "description": "Individual user progress document."
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "List of administrative users."
    },
    "study_tips/{tipId}": {
      "schema": "StudyTip",
      "description": "Shared real-time study tips and NECTA traps."
    }
  }
}
