{
  "entities": {
    "UserProgress": {
      "title": "User Progress",
      "description": "Stores points, streak, level and completed topics for a student.",
      "type": "object",
      "properties": {
        "points": { "type": "number", "description": "Accumulated experience points (EP)." },
        "credits": { "type": "number", "description": "Paid credits for premium features." },
        "streak": { "type": "number", "description": "Consecutive days of study." },
        "level": { "type": "number", "description": "Student's level based on EP." },
        "completedTopics": { "type": "array", "description": "List of IDs for completed topics." },
        "userId": { "type": "string", "description": "The UID of the user." },
        "email": { "type": "string", "description": "User email address." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last time the progress was updated." }
      },
      "required": ["points", "credits", "streak", "level", "completedTopics", "userId"]
    },
    "Admin": {
      "title": "Admin User",
      "description": "Users with administrative privileges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "StudyTip": {
      "title": "Study Room Tip",
      "description": "Quick text tips, formulas, and common NECTA exam traps shared by students.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "authorName": { "type": "string" },
        "authorId": { "type": "string" },
        "type": { "type": "string", "enum": ["tip", "trap", "formula", "question"] },
        "content": { "type": "string" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "subjectId", "authorName", "authorId", "type", "content", "likes", "createdAt"]
    },
    "StudyBuddy": {
      "title": "Study Buddy Presence",
      "description": "Active students open for topic-based study buddy matching in NECTA subjects.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarId": { "type": "string" },
        "schoolName": { "type": "string" },
        "region": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "topicTitle": { "type": "string" },
        "studyGoal": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "in_session", "seeking_help", "ready_to_tutor"] },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "displayName", "gradeLevel", "subjectId", "subjectName", "topicTitle", "status"]
    },
    "StudyBuddySession": {
      "title": "Collaborative Problem-Solving Session",
      "description": "Collaborative revision workspace where matched study buddies solve NECTA questions together.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "topicTitle": { "type": "string" },
        "questionOrProblem": { "type": "string" },
        "participants": { "type": "array" },
        "steps": { "type": "array" },
        "finalAnswer": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "solved", "waiting_for_buddy"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "subjectId", "subjectName", "topicTitle", "participants", "status"]
    },
    "StudyBuddyMessage": {
      "title": "Study Buddy Chat Message",
      "description": "Real-time communication message inside a topic collaboration session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "step_proposal", "formula", "hint", "yun_ai_referee"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sessionId", "senderId", "senderName", "content", "type", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProgress",
      "description": "Individual user progress document."
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "List of administrative users."
    },
    "study_tips/{tipId}": {
      "schema": "StudyTip",
      "description": "Shared real-time study tips and NECTA traps."
    },
    "study_buddies/{buddyId}": {
      "schema": "StudyBuddy",
      "description": "Active students open for topic-based study buddy matching."
    },
    "study_buddy_sessions/{sessionId}": {
      "schema": "StudyBuddySession",
      "description": "Collaborative problem-solving workspaces between study buddies."
    },
    "study_buddy_messages/{messageId}": {
      "schema": "StudyBuddyMessage",
      "description": "Real-time chat messages inside study buddy problem-solving sessions."
    }
  }
}
